---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

type Props = {
  pageTitle?: string;
  pageDescription?: string;
  ogImage?: string;
  siteName: string;
  titleTemplate?: string;
};

const {
  pageTitle,
  pageDescription,
  ogImage,
  siteName,
  titleTemplate = "%s",
} = Astro.props;

const resolvedTitle = pageTitle ?? siteName;
const title = titleTemplate.replace("%s", resolvedTitle);
const description = pageDescription ?? "";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site ?? Astro.url).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <script is:inline>
      (() => {
        const validThemes = ["day", "sunset", "night"];
        const legacyThemes = {
          light: "day",
          colorful: "sunset",
          dark: "night",
        };
        const savedTheme = window.localStorage.getItem("site-theme");
        const theme = validThemes.includes(savedTheme ?? "")
          ? savedTheme
          : legacyThemes[savedTheme] ?? "day";
        document.documentElement.setAttribute("data-theme", theme);
        window.localStorage.setItem("site-theme", theme);
      })();
    </script>

    <ClientRouter fallback="animate" />

  </head>
  <body>
    <slot />
  </body>
</html>
